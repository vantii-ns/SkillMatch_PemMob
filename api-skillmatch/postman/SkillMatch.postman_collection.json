{
  "info": {
    "name": "SkillMatch API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan folder 0 (Login) lebih dulu agar variabel token terisi otomatis."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id_tim",
      "value": "1"
    },
    {
      "key": "id_undangan",
      "value": "1"
    },
    {
      "key": "id_users",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "0. Auth (M1)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Dina Mahasiswa\",\n  \"email\": \"dina@contoh.com\",\n  \"password\": \"password123\",\n  \"peran_utama\": \"developer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);",
                  "pm.test(\"status sukses\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register gagal (email salah) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"X\",\n  \"email\": \"salah\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (Andi, akun contoh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
