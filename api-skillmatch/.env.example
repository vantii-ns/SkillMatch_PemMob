# =============================================================================
# SkillMatch API — Environment Variables Template
# SALIN file ini menjadi .env lalu isi nilainya
# JANGAN commit file .env ke git!
# =============================================================================

# -- Server
PORT=3000
NODE_ENV=development

# -- Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=skillmatch_user
# Gunakan password yang kuat! Minimal 16 karakter
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_16_KARAKTER
DB_NAME=db_skillmatch

# -- JWT (JSON Web Token)
# WAJIB: Minimal 32 karakter acak
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=7d

# -- GitHub API (opsional)
GITHUB_TOKEN=
GITHUB_REQUIRE_BIO_PROOF=true

# -- CORS (untuk web frontend, kosongkan jika hanya mobile app)
# Contoh: https://skillmatch.example.com
CORS_ALLOWED_ORIGINS=
